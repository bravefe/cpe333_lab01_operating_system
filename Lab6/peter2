#include <stdio.h>
#include <pthread.h>
#include <unistd.h>

// Peterson lock structure

// Shared Peterson lock variables
int lock[2] = {0, 0};
int turn;

// Shared resource
int counter = 0;

// Lock function
void lock_acquire(int process) {
    int other = 1 - process;

    lock[process] = 1;
    turn = other;

    while (lock[other] && turn == other) {
        // Busy waiting
    }
}

// Unlock function
void unlock(int process) {
    lock[process] = 0;
}

// Thread function
void *process(void *arg) {
    int process_id = *(int *)arg;

    for (int i = 0; i < 100000; i++) {

        // Lock
        lock_acquire(process_id);

        // Critical section
        counter++;

        // Unlock
        unlock(process_id);
    }

    return NULL;
}

int main() {
    pthread_t thread1, thread2;

    int id1 = 0;
    int id2 = 1;

    // Create two threads
    pthread_create(&thread1, NULL, process, &id1);
    pthread_create(&thread2, NULL, process, &id2);

    // Wait for both threads
    pthread_join(thread1, NULL);
    pthread_join(thread2, NULL);

    printf("Final counter value: %d\n", counter);

    return 0;
}